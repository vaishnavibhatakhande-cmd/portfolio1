# Email configuration for the portfolio contact form

# OPTION A: Web3Forms (Recommended - Easiest setup, just one key)
# Get a free key at https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=

# OPTION B: EmailJS
# Set these up at https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
